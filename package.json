{
  "name": "springforth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Springforth — community coordination infrastructure: possibility cards, resource matching, explainable overlap detection, open-evidence verification.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test && pnpm design:check",
    "test": "vitest run",
    "seed": "node --experimental-strip-types scripts/seed-d1.mjs",
    "design:check": "node scripts/design-check.mjs",
    "design:scan": "for a in landing deck console instrument reference tour-all; do node .devin/skills/ss-score/scripts/styleseed-check.mjs scan --project-root . --artifact $a --format json; done",
    "a11y:check": "node scripts/a11y-check.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "upstream": "node scripts/upstream-check.mjs",
    "web:build": "cd web && react-router build",
    "web:dev": "cd web && react-router dev",
    "web:deploy": "cd web && wrangler deploy",
    "web:typecheck": "cd web && react-router typegen && tsc -b",
    "web:preview": "cd web && react-router build && vite preview"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource/dm-serif-display": "5.3.0",
    "@modelcontextprotocol/sdk": "1.25.2",
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "@stellar/stellar-sdk": "17.2.1",
    "@worldcoin/minikit-js": "2.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "cobe": "2.0.1",
    "d3-shape": "3.2.0",
    "devalue": "6.0.3",
    "embla-carousel-react": "8.6.0",
    "graphology": "0.26.0",
    "graphology-layout-forceatlas2": "0.10.1",
    "graphology-types": "0.24.7",
    "h3-js": "4.3.0",
    "i18next": "26.4.6",
    "isbot": "5.2.2",
    "lucide-react": "1.57.0",
    "marked": "17.0.1",
    "minisearch": "7.2.0",
    "motion": "14.3.0",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.0.9",
    "react-router": "7.18.4",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "vaul": "1.1.2",
    "viem": "^2.38.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@react-router/dev": "7.18.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/d3-shape": "3.1.7",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "papaparse": "5.5.3",
