{
  "schemaVersion": 1,
  "id": "reference",
  "target": {
    "kind": "route",
    "locator": "/docs"
  },
  "selection": {
    "grammar": "editorial-reading",
    "page": "detail"
  },
  "decisions": {
    "primaryDecision": "read API and protocol documentation",
    "primaryAction": "read docs / follow a link to a live route",
    "signatureMove": "documentation rendered in product chrome, not a bare page"
  },
  "implementation": {
    "sourceRoots": [
      "src/portal/docs.ts",
      "src/portal/actor.ts",
      "src/portal/claim.ts",
      "src/portal/report.ts",
      "src/portal/whitepaper.ts",
      "src/portal/strings",
      "src/portal/theme.ts",
      "src/portal/i18n.ts",
      "web/app/routes/docs.tsx",
      "web/app/routes/actor.tsx",
      "web/app/routes/claim.tsx",
      "web/app/routes/report.tsx",
      "web/app/routes/whitepaper.tsx",
      "web/app/routes/search.tsx",
      "web/app/routes/not-found.tsx"
    ],
    "tokenFiles": [
      "src/portal/theme.ts",
      "web/app/app.css"
    ]
  },
  "validation": {
    "scoreFloor": 85,
    "requiredRenders": [
      {
        "id": "desktop-loaded",
        "state": "loaded",
        "viewport": {
          "width": 1440,
          "height": 900
        }
      },
      {
        "id": "mobile-loaded",
        "state": "loaded",
        "viewport": {
          "width": 390,
          "height": 844
        }
      }
    ],
    "temporal": {
      "required": false,
      "scenarios": []
    },
    "humanAcceptance": false
  }
}